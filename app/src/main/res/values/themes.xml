<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StarrootIsle" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/starroot</item>
        <item name="android:statusBarColor">@color/sky_night</item>
        <item name="android:navigationBarColor">@color/sky_night</item>
        <item name="android:windowBackground">@color/sky_night</item>
    </style>

    <style name="Theme.StarrootIsle.Fullscreen" parent="Theme.StarrootIsle">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
